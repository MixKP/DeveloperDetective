# ---------------------------------------------------------------------------
# Developer Detective — environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase PostgreSQL ---------------------------------------------------
# Supabase gives you TWO connection strings. They are not interchangeable.
#
#  DATABASE_URL        -> Transaction pooler, port 6543. Used by the running API.
#                         Prepared statements are disabled in code (prepare: false)
#                         because PgBouncer transaction mode cannot support them.
#
#  DIRECT_DATABASE_URL -> Direct connection, port 5432. Used by drizzle-kit for
#                         migrations only. Migrations need session-level features
#                         the pooler does not provide.
#
# Find both under: Supabase Dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- API -------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Comma-separated origins allowed in development only. Ignored in production,
# where nginx proxies /api and everything is same-origin.
CORS_ORIGINS=http://localhost:5173

# --- Web -------------------------------------------------------------------
# Host port for the nginx container.
WEB_PORT=8080
# Base URL the SPA calls. Leave as /api so nginx proxies it (same-origin).
VITE_API_BASE_URL=/api
