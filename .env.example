# ---------------------------------------------------------------------------
# Developer Detective — environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Supabase PostgreSQL ---------------------------------------------------
# Two targets. Uncomment ONE pair. See the README for which to pick when.
#
#  DATABASE_URL        -> used by the running API.
#  DIRECT_DATABASE_URL -> used by db:migrate and db:seed. Migrations need
#                         session-level features a transaction pooler does not
#                         provide, so these are not interchangeable against the
#                         managed project.

# Local stack (`npx supabase start`). No pooler, so both are the same direct
# connection, and these credentials are the CLI's fixed local defaults.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Read only by docker-compose, which overrides DATABASE_URL for the api
# container: 127.0.0.1 inside a container is the container, not your machine.
# Comment it out when the target is the managed project.
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# Managed project. Copy both strings whole from
# Supabase Dashboard > Project Settings > Database > Connection string —
# do not hand-edit the host, the pooler region is part of it.
# Port 6543 is the transaction pooler; prepared statements are disabled in code
# (prepare: false) because PgBouncer transaction mode cannot support them.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- API -------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
# Comma-separated origins allowed in development only. Ignored in production,
# where nginx proxies /api and everything is same-origin.
CORS_ORIGINS=http://localhost:5173

# --- Web -------------------------------------------------------------------
# Host port for the nginx container.
WEB_PORT=8080
# Base URL the SPA calls. Leave as /api so nginx proxies it (same-origin).
VITE_API_BASE_URL=/api
