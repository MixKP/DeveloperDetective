{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // playwright.config.ts belongs to the root tsconfig, not this one: a file claimed by two
  // projects leaves the editor to pick, and it does not always pick the same one you did.
  "include": ["**/*.ts"]
}
