{
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @dd/shared && npm run build -w @dd/frontend",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/((?!router$).*)",
      "destination": "/api/router"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
